{
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://ron-system-product-name.tail38a93d.ts.net/agentreg/v1/:path*"
    },
    {
      "source": "/agents/:path*",
      "destination": "https://ron-system-product-name.tail38a93d.ts.net/agentreg/agents/:path*"
    },
    {
      "source": "/categories/:path*",
      "destination": "https://ron-system-product-name.tail38a93d.ts.net/agentreg/categories/:path*"
    },
    {
      "source": "/blog",
      "destination": "https://ron-system-product-name.tail38a93d.ts.net/agentreg/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://ron-system-product-name.tail38a93d.ts.net/agentreg/blog/:path*"
    },
    {
      "source": "/claim",
      "destination": "https://ron-system-product-name.tail38a93d.ts.net/agentreg/claim"
    },
    {
      "source": "/og-image/:path*",
      "destination": "https://ron-system-product-name.tail38a93d.ts.net/agentreg/og-image/:path*"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "https://ron-system-product-name.tail38a93d.ts.net/agentreg/.well-known/:path*"
    },
    {
      "source": "/openapi.json",
      "destination": "https://ron-system-product-name.tail38a93d.ts.net/agentreg/openapi.json"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.agentseek.co"
        }
      ],
      "destination": "https://agentseek.co/:path*",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/#pricing",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/signup",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/register",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/v1/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://agentseek.co"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-API-Key,X-Admin-Key,Content-Type"
        }
      ]
    }
  ]
}